# Environment Variables for Bioinformatics Container Environment - macOS
# Copy this file to .env and customize as needed

# User ID and Group ID for file permissions
# On macOS, use your actual user/group IDs
# Get your IDs with: id -u && id -g
USERID=501
GROUPID=20

# RStudio password. REQUIRED, no default. Generate one with: openssl rand -base64 24
RSTUDIO_PASSWORD=

# Jupyter token. REQUIRED, no default. Generate one with: openssl rand -hex 24
JUPYTER_TOKEN=

# Disable authentication (set to false for production)
DISABLE_AUTH=false

# Memory limits (adjust based on your system)
# Note: Adjust based on your system resources
MEMORY_LIMIT=16G
MEMORY_RESERVATION=8G

# Ports (change if defaults are in use)
RSTUDIO_PORT=8787
JUPYTER_PORT=8888
VSCODE_PORT=8080